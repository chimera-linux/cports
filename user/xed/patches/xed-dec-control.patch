@@ -27,8 +27,10 @@
 # include <sys/types.h>
 # include <sys/stat.h>
 # include <fcntl.h>
+#if defined(__x86_64__) || defined(__i386__)
 #include <cpuid.h>
 #endif
+#endif
 #include <ctype.h>
 #include <stdlib.h>
 #include <assert.h>
@@ -1713,16 +1715,3 @@
 
