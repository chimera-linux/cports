 namespace L0 {
 class UdevLib {
diff --git a/shared/offline_compiler/source/utilities/linux/safety_guard_linux.h b/shared/offline_compiler/source/utilities/linux/safety_guard_linux.h
index dce5832..8cf117f 100644
--- a/shared/offline_compiler/source/utilities/linux/safety_guard_linux.h
+++ b/shared/offline_compiler/source/utilities/linux/safety_guard_linux.h
@@ -13,7 +13,9 @@
 #include <csignal>
 #include <cstdio>
 #include <cstdlib>
+#ifdef __GLIBC__
 #include <execinfo.h>
+#endif
 
 static jmp_buf jmpbuf;
 
@@ -38,19 +40,23 @@ class SafetyGuardLinux : NEO::NonCopyableAndNonMovableClass {
     }
 
     static void sigAction(int sigNum, siginfo_t *info, void *ucontext) {
+#ifdef __GLIBC__
         const int callstackDepth = 30;
         void *addresses[callstackDepth];
         char **callstack;
         int backtraceSize = 0;
 
         backtraceSize = backtrace(addresses, callstackDepth);
         callstack = backtrace_symbols(addresses, backtraceSize);
 
         for (int i = 0; i < backtraceSize; ++i) {
             printf("[%d]: %s\n", i, callstack[i]);
         }
 
         free(callstack);
+#else
+        printf("ERROR: MUSL HAS NO BACKTRACE() or execinfo!\n");
+#endif
         longjmp(jmpbuf, 1);
     }
 
diff --git a/shared/source/os_interface/linux/os_library_helper.cpp b/shared/source/os_interface/linux/os_library_helper.cpp
index 2dc56e9..3fa7b9a 100644
--- a/shared/source/os_interface/linux/os_library_helper.cpp
+++ b/shared/source/os_interface/linux/os_library_helper.cpp
@@ -14,8 +14,13 @@ namespace NEO {
 namespace Linux {
 void adjustLibraryFlags(int &dlopenFlag) {
     if (debugManager.flags.DisableDeepBind.get()) {
+#ifdef RTLD_DEEPBIND
         dlopenFlag &= ~RTLD_DEEPBIND;
+#endif
     }
+#ifndef __GLIBC__
+    dlopenFlag |= RTLD_GLOBAL;
+#endif
 }
 } // namespace Linux
 } // namespace NEO
diff --git a/shared/source/os_interface/linux/sys_calls_linux.cpp b/shared/source/os_interface/linux/sys_calls_linux.cpp
index 06ac6e9..0a8199c 100644
--- a/shared/source/os_interface/linux/sys_calls_linux.cpp
+++ b/shared/source/os_interface/linux/sys_calls_linux.cpp
@@ -87,7 +87,7 @@ int fsync(int fd) {
 }
 
 int ioctl(int fileDescriptor, unsigned long int request, void *arg) {
-    return ::ioctl(fileDescriptor, request, arg);
+    return ::ioctl(fileDescriptor, (int)request, arg);
 }
 
 void *dlopen(const char *filename, int flag) {
