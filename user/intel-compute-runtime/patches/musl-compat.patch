index bc031ff..a7c35f2 100644
--- a/level_zero/tools/source/sysman/linux/udev/udev_lib.h
+++ b/level_zero/tools/source/sysman/linux/udev/udev_lib.h
@@ -9,6 +9,9 @@
 
 #include <string>
 #include <vector>
+#ifndef __dev_t_defined
