diff --git a/servconf.c b/servconf.c
index ac0c31d..8f117d8 100644
--- a/servconf.c
+++ b/servconf.c
@@ -309,6 +309,15 @@ fill_default_server_options(ServerOptions *options)
 		options->pam_service_name = xstrdup(SSHD_PAM_SERVICE);
 #endif
 
+	if (options->num_subsystems == 0) {
+		options->subsystem_name = xrecallocarray(options->subsystem_name, 0, 1, sizeof(*options->subsystem_name)); \
+		options->subsystem_name[0] = xstrdup("sftp"); \
+		options->subsystem_command = xrecallocarray(options->subsystem_command, 0, 1, sizeof(*options->subsystem_command)); \
+		options->subsystem_command[0] = xstrdup(_PATH_SFTP_SERVER); \
+		options->subsystem_args = xrecallocarray(options->subsystem_args, 0, 1, sizeof(*options->subsystem_args)); \
+		options->subsystem_args[0] = xstrdup(_PATH_SFTP_SERVER); \
+		options->num_subsystems = 1;
+	}
 	if (options->num_host_key_files == 0) {
 		/* fill default hostkeys */
 		servconf_add_hostkey("[default]", 0, options,
@@ -386,10 +395,6 @@ fill_default_server_options(ServerOptions *options)
 		    &options->authorized_keys_files,
 		    &options->num_authkeys_files,
 		    _PATH_SSH_USER_PERMITTED_KEYS);
-		opt_array_append("[default]", 0, "AuthorizedKeysFiles",
-		    &options->authorized_keys_files,
-		    &options->num_authkeys_files,
-		    _PATH_SSH_USER_PERMITTED_KEYS2);
 	}
 	if (options->ip_qos_interactive == -1)
 		options->ip_qos_interactive = IPTOS_DSCP_EF;
