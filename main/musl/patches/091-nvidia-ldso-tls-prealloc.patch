 	alloc_size = sizeof *p + strlen(pathname) + 1;
 	if (runtime && temp_dso.tls.image) {
+#ifdef LIBC_NVIDIA_BUILD
+		size_t dyn[DYN_CNT], per_th = sizeof(void *) * (tls_cnt+3);
+		decode_vec(temp_dso.dynv, dyn, DYN_CNT);
