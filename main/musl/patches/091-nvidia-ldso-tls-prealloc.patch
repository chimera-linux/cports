@@ -1687,6 +1752,9 @@ static void update_tls_size()
 	libc.tls_size = ALIGN(
 		(1+tls_cnt) * sizeof(void *) +
 		tls_offset +
+#ifdef LIBC_NVIDIA_BUILD
+		((tls_offset == static_tls_offset) ? STATIC_TLS_PREALLOC : 0) +
+#endif
