off_t is always 64-bit on musl. This will propagate to the rest of libdvdread
via includes.
---
diff --git a/src/dvdread/dvd_filesystem.h b/src/dvdread/dvd_filesystem.h
index 926b563..7d20164 100644
--- a/src/dvdread/dvd_filesystem.h
+++ b/src/dvdread/dvd_filesystem.h
@@ -37,10 +37,12 @@ typedef __int64 off64_t;
 #elif defined(__GLIBC__)
 /* sys/types.h may have been included before _LARGEFILE64_SOURCE was defined. */
 typedef __off64_t off64_t;
-#elif defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__) || defined(__DragonFly__)
+#elif defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__) || defined(__DragonFly__) || defined(__linux__)
 /* off_t is already 64 bit here so off64_t is not provided. */
+#ifndef off64_t
 typedef off_t off64_t;
 #endif
+#endif
 
 #define DVDREAD_NAME_MAX 255
 /* directory entry, only d_name is used by the lib */
