From f1f0ad3e3bdc4a222cf849604c4b671ac9ad370f Mon Sep 17 00:00:00 2001
From: q66 <q66@chimera-linux.org>
Date: Sat, 28 Nov 2026 10:44:03 +0100
Subject: [PATCH] Selectively downgrade some crates in cargo

Until we can figure out why it's busted on ppc64le, downgrade
some dependencies until things no longer crash. This is not
sustainable forever but for now it makes it work.
---
 src/tools/cargo/Cargo.lock | 12 +++++++-----
 src/tools/cargo/Cargo.toml |  6 +++---
 2 files changed, 10 insertions(+), 8 deletions(-)

diff --git a/src/tools/cargo/Cargo.lock b/src/tools/cargo/Cargo.lock
index a8337c041..e9f0bf8d2 100644
--- a/src/tools/cargo/Cargo.lock
+++ b/src/tools/cargo/Cargo.lock
@@ -148,9 +148,9 @@ dependencies = [
 
 [[package]]
 name = "anyhow"
-version = "1.0.103"
+version = "1.0.75"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "2a4385e2e34eb35d6b3efe798b9eb88096925d87726c0798709bf56d9ed84af3"
+checksum = "a4668cab20f66d8d020e1fbc0ebe47217433c1b6c8f2040faf858554e394ace6"
 
 [[package]]
 name = "arc-swap"
@@ -2692,16 +2692,18 @@ dependencies = [
 
 [[package]]
 name = "ignore"
-version = "0.4.26"
+version = "0.4.20"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "b915661dd01db3f05050265b2477bcc6527b3792388e2749b41623cc592be67d"
+checksum = "dbe7873dab538a9a44ad79ede1faf5f30d49f9a5c883ddbab48bce81b64b7492"
 dependencies = [
  "crossbeam-deque",
  "globset",
+ "lazy_static",
  "log",
  "memchr",
- "regex-automata",
+ "regex",
  "same-file",
+ "thread_local",
  "walkdir",
  "winapi-util",
 ]
diff --git a/src/tools/cargo/Cargo.toml b/src/tools/cargo/Cargo.toml
index 6d8001085..d39957c37 100644
--- a/src/tools/cargo/Cargo.toml
+++ b/src/tools/cargo/Cargo.toml
@@ -22,7 +22,7 @@ anstream = "1.0.0"
 anstyle = "1.0.14"
 anstyle-hyperlink = "1.0.2"
 anstyle-progress = "0.1.0"
-anyhow = "1.0.102"
+anyhow = "1.0.75"
 async-trait = "0.1.89"
 base64 = "0.23.0"
 blake3 = "1.8.4"
@@ -64,7 +64,7 @@ hmac = "0.13.0"
 home = "0.5.12"
 http = "1.4.0"
 http-auth = { version = "0.1.10", default-features = false }
-ignore = "0.4.25"
+ignore = "0.4.20"
 im-rc = "15.1.0"
 indexmap = "2.13.0"
 itertools = "0.15.0"
@@ -73,7 +73,7 @@ jobserver = "0.1.34"
 libc = "0.2.184"
 libgit2-sys = "0.18.5"
 libloading = "0.9.0"
-memchr = "2.8.0"
+memchr = "2.6.0"
 memfd = "0.6.5"
 miow = "0.6.1"
 opener = "0.8.4"
-- 
2.56.1

