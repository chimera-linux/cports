From 4605e884c90a1aea85e4e524b617ec7d094809a1 Mon Sep 17 00:00:00 2001
From: q66 <q66@chimera-linux.org>
Date: Sun, 22 Jan 2023 03:00:46 +0100
Subject: [PATCH] avoid use of atoi in library code

If this overflows, it will trap.
---
 src/libical/icalcomponent.c | 6 +++---
 src/libical/icalrecur.c     | 4 ++--
 src/libical/icalvalue.c     | 6 +++---
 src/libicalvcal/icalvcal.c  | 4 ++--
 4 files changed, 10 insertions(+), 10 deletions(-)

-- 
2.39.0

diff -ruN a/src/libical/icalcomponent.c b/src/libical/icalcomponent.c
--- a/src/libical/icalcomponent.c	2026-08-15 21:07:32.000000000 +0200
+++ b/src/libical/icalcomponent.c	2026-09-29 10:04:15.785729639 +0200
@@ -2313,7 +2313,7 @@
                                                         const char *tzid,
                                                         icalstrarray *tzids_to_rename)
 {
-    int max_suffix = 0;
+    long max_suffix = 0;
     size_t i, num_elements, tzid_len;
     char *new_tzid, suffix_buf[32];
 
@@ -2368,7 +2368,7 @@
 
                 /* Convert the suffix to an integer and remember the maximum numeric
                    suffix found. */
-                int suffix = atoi(existing_tzid + existing_tzid_len);
+                long suffix = strtol(existing_tzid + existing_tzid_len, NULL, 10);
                 if (max_suffix < suffix) {
                     max_suffix = suffix;
                 }
@@ -2384,7 +2384,7 @@
         return;
     }
 
-    snprintf(suffix_buf, sizeof(suffix_buf), "%i", max_suffix + 1);
+    snprintf(suffix_buf, sizeof(suffix_buf), "%ld", max_suffix + 1);
     const size_t len_new_tzid = tzid_len + strlen(suffix_buf) + 1;
     new_tzid = icalmemory_new_buffer(len_new_tzid);
     if (!new_tzid) {
diff -ruN a/src/libical/icalrecur.c b/src/libical/icalrecur.c
--- a/src/libical/icalrecur.c	2026-08-15 21:07:32.000000000 +0200
+++ b/src/libical/icalrecur.c	2026-09-29 10:05:11.569522278 +0200
@@ -940,7 +940,7 @@
                 /* Don't allow multiple COUNTs, or both COUNT and UNTIL */
                 r = -1;
             } else {
-                parser.rt->count = atoi(value);
+                parser.rt->count = (int)strtol(value, NULL, 10);
                 /* don't allow count to be less than 1 */
                 if (parser.rt->count < 1) {
                     r = -1;
@@ -961,7 +961,7 @@
                 /* Don't allow multiple INTERVALs */
                 r = -1;
             } else {
-                int tmp = atoi(value);
+                int tmp = (int)strtol(value, NULL, 10);
                 parser.rt->interval = (short)tmp;
 
                 // overflow?
diff -ruN a/src/libical/icalvalue.c b/src/libical/icalvalue.c
--- a/src/libical/icalvalue.c	2026-08-15 21:07:32.000000000 +0200
+++ b/src/libical/icalvalue.c	2026-09-29 10:03:27.220910165 +0200
@@ -555,11 +555,11 @@
         break;
 
     case ICAL_INTEGER_VALUE:
-        value = icalvalue_new_integer(atoi(str));
+        value = icalvalue_new_integer((int)strtol(str, NULL, 10));
         break;
 
     case ICAL_FLOAT_VALUE:
-        value = icalvalue_new_float((float)atof(str));
+        value = icalvalue_new_float((float)strtod(str, NULL));
         break;
 
     case ICAL_UTCOFFSET_VALUE: {
diff -ruN a/src/libicalvcal/icalvcal.c b/src/libicalvcal/icalvcal.c
--- a/src/libicalvcal/icalvcal.c	2026-08-15 21:07:32.000000000 +0200
+++ b/src/libicalvcal/icalvcal.c	2026-09-29 10:06:19.241270725 +0200
@@ -315,7 +315,7 @@
         } else if (!strcmp(name, VCRepeatCountProp)) {
             /* If it starts with a digit convert it into a REPEAT property. */
             if (*s && *s >= '0' && *s <= '9') {
-                repeat_prop = icalproperty_new_repeat(atoi(s));
+                repeat_prop = icalproperty_new_repeat((int)strtol(s, NULL, 10));
                 icalcomponent_add_property(comp, repeat_prop);
             }
 
@@ -613,7 +613,7 @@
 
     /* GnomeCalendar outputs '-1' for this. I have no idea why.
        So we just check it is a valid +ve integer, and output 0 if it isn't. */
-    sequence = atoi(s);
+    sequence = (int)strtol(s, NULL, 10);
     if (sequence < 0) {
         sequence = 0;
     }
