From 0b1cb8bcb3bf8bd666521a63c0be1e9da51e2337 Mon Sep 17 00:00:00 2001
From: Amin Vakil <info@aminvakil.com>
Date: Wed, 30 Sep 2026 21:46:06 +0330
Subject: [PATCH] pvscan: preserve preferred device name when importing
 DEVLINKS

DEVLINKS may contain symlinks that udev has not created yet. Adding
these aliases through _add_alias can promote a pending symlink over the
usable device path, causing size detection and autoactivation to fail.

Restore the original preferred alias after adding each DEVLINKS entry,
while retaining allocation from the device-cache memory pool.

Add an in-memory regression test for preferred-name preservation and
alias retention, with a dependency on the generated command header.

Fixes: 5d399b814e7a ("pvscan: fix UAF in DEVLINKS alias handling")
---
 WHATS_NEW               |  1 +
 lib/device/dev-cache.c  | 16 +++++++-
 test/unit/Makefile      |  4 ++
 test/unit/dev_cache_t.c | 88 +++++++++++++++++++++++++++++++++++++++++
 test/unit/units.h       |  2 +
 5 files changed, 110 insertions(+), 1 deletion(-)
 create mode 100644 test/unit/dev_cache_t.c

diff --git a/lib/device/dev-cache.c b/lib/device/dev-cache.c
index ec48d3474..8cb7a7c57 100644
--- a/lib/device/dev-cache.c
+++ b/lib/device/dev-cache.c
@@ -336,7 +336,21 @@ out:
 
 int dev_cache_add_alias(struct device *dev, const char *name)
 {
-	return _add_alias(dev, name, NO_HASH);
+	struct dm_list *preferred = dm_list_first(&dev->aliases);
+
+	if (!_add_alias(dev, name, NO_HASH))
+		return 0;
+
+	/*
+	 * pvscan imports DEVLINKS for regex filters before udev creates symlinks.
+	 * Keep the existing preferred name for opening the device.
+	 */
+	if (preferred) {
+		dm_list_del(preferred);
+		dm_list_add_h(&dev->aliases, preferred);
+	}
+
+	return 1;
 }
 
 int get_sysfs_binary(const char *path, char *buf, size_t buf_size, int *retlen)
diff --git a/test/unit/Makefile b/test/unit/Makefile
index 40cc545fe..4ee651dd2 100644
--- a/test/unit/Makefile
+++ b/test/unit/Makefile
@@ -16,6 +16,7 @@
 UNIT_SOURCE=\
 	test/unit/bcache_t.c \
 	test/unit/daemon_stray_t.c \
+	test/unit/dev_cache_t.c \
 	test/unit/bcache_utils_t.c \
 	test/unit/bitset_t.c \
 	test/unit/config_t.c \
@@ -49,6 +50,9 @@ CLEAN_TARGETS += $(UNIT_DEPENDS) $(UNIT_OBJECTS) \
 lib/liblvm-internal.a: lib
 libdaemon/client/libdaemonclient.a: libdaemon
 
+# toolcontext.h requires the generated cmds.h.
+test/unit/dev_cache_t.o: | include
+
 $(UNIT_TARGET): $(UNIT_OBJECTS) $(LVMINTERNAL_LIBS)
 	$(SHOW) "    [LD] $@"
 	$(Q) $(CC) $(CFLAGS) $(LDFLAGS) $(EXTRA_EXEC_LDFLAGS) \
diff --git a/test/unit/dev_cache_t.c b/test/unit/dev_cache_t.c
new file mode 100644
index 000000000..8e748a9fa
--- /dev/null
+++ b/test/unit/dev_cache_t.c
@@ -0,0 +1,88 @@
