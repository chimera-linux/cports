+"Usage: %s [-a | -m] [FORMAT] name...\n"
+"\n"
+"\t-a, --all-locales\tWrite names of all available locales\n"
+"\t-m, --charmaps\tWrite names of available charmaps\n"
+"\n"
+"FORMAT:\n"
+"\t-c, --category-name\tWrite names of selected categories\n"
+"\t-k, --keyword-name\tWrite names of selected keywords\n"
+msgstr ""
+"Bruk: %s [-a | -m] [FORMAT] namn ...\n"
+"\n"
+"\t-a, --all-locales\tList opp alle tilgjengelege lokalar\n"
+"\t-m, --charmaps\tList opp alle tilgjengelege teiknmappingar\n"
+"\n"
+"FORMAT:\n"
+"\t-c, --category-name\tList opp namna på dei valde kategoriane\n"
+"\t-k, --keyword-name\tList opp namna på dei valde nøkkelorda\n"
