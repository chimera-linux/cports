From f31be203a79e6f60de2197a473cca00405e77d94 Mon Sep 17 00:00:00 2001
From: Sven Eden <sven@eden-worx.com>
Date: Tue, 6 Oct 2026 16:14:54 +0200
Subject: [PATCH] src/basic/hostname-util.c: Use fixed 64-byte hostname length
 limit

HOST_NAME_MAX has a length over 64 on MUSL

+# Validate hostname length against Linux 64-byte limit regardless of
  libc
+# Replace HOST_NAME_MAX with explicit 64 on all libcs to ensure
  consistency

Bug: #357
Signed-off-by: Sven Eden <sven@eden-worx.com>
---
 src/basic/hostname-util.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/basic/hostname-util.c b/src/basic/hostname-util.c
index 300cf1c067..3d68935c7c 100644
--- a/src/basic/hostname-util.c
+++ b/src/basic/hostname-util.c
@@ -128,8 +128,12 @@ bool hostname_is_valid(const char *s, ValidHostnameFlags flags) {
         if (hyphen)
                 return false;
 
+#if 0 /// elogind: HOST_NAME_MAX differs across libcs; validate against the Linux limit of 64 on all libcs
         if (p-s > HOST_NAME_MAX) /* Note that HOST_NAME_MAX is 64 on Linux, but DNS allows domain names up to
                                   * 255 characters */
+#else // 0
+        if (p-s > 64) /* HOST_NAME_MAX is 64 on Linux, but DNS allows domain names up to 255 characters */
+#endif // 0
                 return false;
 
         return true;
